  "components": [
    {
      "name": "Homepage hero action", "kind": "button",
      "description": "Pale square action over the photographic scene; minimum 48px height and reversed focus outline.",
      "html": "<div class=\"ds-home-hero-sample\"><a class=\"ds-home-primary\" href=\"/start\">從新手入門<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></div>",
      "css": ".ds-home-hero-sample{background:#192019;padding:24px}.ds-home-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;min-height:48px;padding:12px 21px;border:1px solid #f1e6d0;border-radius:0;background:#f1e6d0;color:#283125;font-family:var(--font-sans);font-size:13px;letter-spacing:.07em;text-decoration:none;transition:color 180ms,background-color 180ms,border-color 180ms,box-shadow 180ms}.ds-home-primary:hover{background:#fff8ea;border-color:#fff8ea}.ds-home-primary:focus-visible{outline:2px solid #fff5e3;outline-offset:6px}.ds-home-primary svg{flex-shrink:0;transition:transform 220ms ease-out}.ds-home-primary:hover svg{transform:translate(2px,-2px)}@media(max-width:560px){.ds-home-primary{font-size:12px;gap:20px;padding:10px 16px}}@media(max-width:360px){.ds-home-primary{gap:15px}}@media(prefers-reduced-motion:reduce){.ds-home-primary,.ds-home-primary svg{transition:none}.ds-home-primary:hover svg{transform:none}}"
    },
