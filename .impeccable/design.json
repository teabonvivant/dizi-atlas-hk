    "homepage": {
      "scope": "Only /, its header and footer; docs/classical-home-direction.md supersedes the previous homepage brief. app/home-classical.css is the implementation source.",
      "layout": "Reading measure min(1280px, calc(100% - 128px)); 40px gutters at max-width 1100px, 22px at 560px. Hero: min-height 720px and height min(900px,100svh); at 780px use min-height 700px, height 90svh, max-height 850px; at 560px use min-height 690px, height 92svh, max-height 810px.",
      "image": "Cover crop: centre 56%; 58% centre at max-width 780px; 80% centre at 560px keeps the flute visible. The picture supplies the 960px source at max-width 680px. Text remains HTML.",
      "stories": "One lead plus three supporting rows; stack the lead and show three supporting columns at 780px, then 100px image/text rows at 560px. Supporting summaries use home-summary and clamp to three lines only on phones. Full text remains on article routes.",
      "learning": "Six routes use two columns, becoming one at 560px. The music-room introduction stacks above the routes at 780px. Intro, search and sources become single-column at 560px.",
      "navigation": "Absolute overlay, 94px minimum header height, 83px at max-width 560px. Desktop links begin at 1120px; header icon controls are at least 44px square at every width. Menus close on route changes, outside clicks or Escape; Escape from an open mobile menu restores toggle focus.",
      "theme": "Scoped chamber variables have dark-chamber counterparts. The open mobile menu uses those paper, ink, muted and rule roles; the photographic hero and closed header remain pale in both themes. Desktop dropdowns remain warm paper with dark ink.",
      "search": "GET /search with q, explicit input label, transparent 48px-minimum field and submit control between top/bottom rules. At 560px input text is 16px and the 44px-minimum icon submit keeps its visually hidden accessible name.",
      "footer": "Homepage alone applies its dark music-room footer roles, 500-weight Chinese title and positive tracking, hides the oversized English wordmark, and reduces top padding from 58px to 44px at 560px."
    },
